{
  "$schema": "https://opencode.ai/config.json",
  "model": "experiential/deepseek-v4.1-flash",
  "providers": {
    "experiential": {
      "name": "Experiential Labs",
      "env": ["EXPLABS_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.experientiallabs.ai/v1",
        "apiKey": "{env:EXPLABS_API_KEY}",
        "encoding": "none"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash via Experiential",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    }
  },
  "permissions": [
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "read", "resource": "server.py", "effect": "deny" },
    { "action": "read", "resource": "static/*", "effect": "deny" },
    { "action": "read", "resource": "Dockerfile", "effect": "deny" },
    { "action": "edit", "resource": "*", "effect": "deny" }
  ]
}
