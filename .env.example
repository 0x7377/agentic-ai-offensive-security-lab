# Copy this file to .env before starting ARTEX.
POSTGRES_USER=artex
POSTGRES_PASSWORD=replace-with-a-classroom-password
POSTGRES_DB=artex
ARTEX_ADMIN_PASSWORD=replace-with-an-admin-password
ARTEX_BIND=127.0.0.1
ARTEX_TAG=v0.3.15-global.1
ARTEX_LANG=ko

# Optional LLM defaults. The same values can be configured in the ARTEX UI.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

